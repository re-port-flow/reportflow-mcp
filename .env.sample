# Re:port Flow MCP Server
# 通常設定不要 — このまま .mcp.json で起動するだけで本番接続できます。
# 公式 OAuth client (reportflow-mcp) が組み込み済みのため env は全て任意です。

# ─── すべて任意 (上書き用) ─────────────────────────────────────────────

# OAuth2 client_id を上書き (デフォルト: 'reportflow-mcp')
# REPORTFLOW_CLIENT_ID=

# テンプレート複製 API へ送る app-key ヘッダーを上書き (デフォルト: 'reportflow-mcp')
# reposts-api の VerifyVersion ガードが必須とするヘッダー。ガードは値を検証しない
# (非空文字列なら通る) ため通常は変更不要。CDN / WAF が特定の値を要求する場合のみ設定。
# REPORTFLOW_APP_KEY=

# 生成 PDF / ZIP の出力ディレクトリ (デフォルト: process.cwd())
# 例: ./output や /tmp/reportflow-out など。指定ディレクトリは自動作成。
# REPORTFLOW_OUTPUT_DIR=

# 開発/staging 環境で別 URL を使う場合のみ上書き
# REPORTFLOW_API_BASE_URL=https://api.re-port-flow.com
# REPORTFLOW_AUTH_URL=https://re-port-flow.com/api/v1

# ローカルコールバックサーバーのポート番号 (デフォルト 53682)
# REPORTFLOW_CALLBACK_PORT=53682

# 要求するスコープ (空白区切り)。未指定時はデフォルト全権限。
# REPORTFLOW_SCOPE=openid profile designs:read designs:write templates:read templates:write pdf:generate

# トークン保存方式: keychain / file。未指定時は keychain → file 自動 fallback。
# REPORTFLOW_TOKEN_STORE=keychain

# file モード時の保存先ディレクトリ。未指定時は $XDG_STATE_HOME/reportflow-mcp。
# REPORTFLOW_TOKEN_STORE_PATH=

# HTTP 版 MCP の Open API 連携トークン。GitHub Actions / ECS では Secret から注入。
# OPENAI_APPS_CHALLENGE_TOKEN=
