# ReportFlow API base (PDF 生成・ダウンロード等のコンテンツサービス)
REPORTFLOW_API_BASE_URL=https://api.re-port-flow.com

# ReportFlow OAuth2 base (reposts-api)
# OIDC discovery: <REPORTFLOW_AUTH_URL>/.well-known/openid-configuration
REPORTFLOW_AUTH_URL=https://re-port-flow.com/api/v1

# OAuth2 Confidential client (ReportFlow Web の OAuth クライアント発行画面で取得)
REPORTFLOW_CLIENT_ID=
REPORTFLOW_CLIENT_SECRET=

# (任意) ローカルコールバックサーバーのポート番号 (デフォルト 53682)
# OAuth クライアント登録時の redirect_uri は http://localhost:<port>/callback
# REPORTFLOW_CALLBACK_PORT=53682

# (任意) 要求するスコープ (空白区切り)。未指定時はデフォルト全権限。
# REPORTFLOW_SCOPE=openid profile designs:read designs:write templates:read templates:write pdf:generate

# (任意) トークン保存方式: keychain / file。未指定時は keychain → file 自動 fallback。
# REPORTFLOW_TOKEN_STORE=keychain

# (任意) file モード時の保存先ディレクトリ。未指定時は $XDG_STATE_HOME/reportflow-mcp。
# REPORTFLOW_TOKEN_STORE_PATH=
