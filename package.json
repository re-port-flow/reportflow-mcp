{
  "name": "reportflow-mcp",
  "version": "1.1.1",
  "description": "ReportFlow MCP Server - PDF report generation for Claude and AI agents",
  "keywords": ["mcp", "pdf", "report", "reportflow", "claude", "anthropic", "ai-agent"],
  "license": "MIT",
  "author": "株式会社マネプラ",
  "homepage": "https://github.com/re-port-flow/report-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/re-port-flow/report-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/re-port-flow/report-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "reportflow-mcp": "dist/index.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"src/**/*.spec.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@napi-rs/keyring": "^1.2.0",
    "open": "^8.4.2",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
"@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
"ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["./src/test-setup.ts"],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", {
        "tsconfig": {
          "module": "CommonJS"
        }
      }]
    },
    "moduleFileExtensions": ["ts", "js", "json"],
    "testMatch": ["**/src/**/*.spec.ts"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
