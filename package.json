{
  "name": "reportflow-mcp",
  "version": "1.4.0",
  "mcpName": "io.github.re-port-flow/reportflow-mcp",
  "description": "Re:port Flow MCP Server - PDF report generation for Claude and AI agents",
  "keywords": [
    "mcp",
    "pdf",
    "report",
    "reportflow",
    "claude",
    "anthropic",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "株式会社マネプラ",
  "homepage": "https://github.com/re-port-flow/reportflow-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/re-port-flow/reportflow-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/re-port-flow/reportflow-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "reportflow-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "start:http": "node dist/index-http.js",
    "dev": "ts-node src/index.ts",
    "dev:http": "ts-node src/index-http.ts",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"src/**/*.spec.ts\" --ignore-pattern \"src/integration/**/*.e2e.ts\"",
    "lint:tsc": "tsc -p tsconfig.build.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e",
    "test:coverage": "jest --selectProjects unit --coverage",
    "test:packaging": "node scripts/packaging-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@napi-rs/keyring": "^1.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "open": "^8.4.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "resolutions": {
    "flatted": "^3.4.2",
    "minimatch": "^9.0.7",
    "picomatch": "^2.3.2",
    "brace-expansion": "^2.0.3",
    "@eslint/eslintrc/ajv": "^6.14.0",
    "js-yaml": "^4.1.1",
    "qs": "^6.15.2",
    "diff": "^4.0.4",
    "@eslint/plugin-kit": "^0.3.4"
  },
  "overrides": {
    "flatted": "^3.4.2",
    "minimatch": "^9.0.7",
    "picomatch": "^2.3.2",
    "brace-expansion": "^2.0.3",
    "@eslint/eslintrc": {
      "ajv": "^6.14.0"
    },
    "js-yaml": "^4.1.1",
    "qs": "^6.15.2",
    "diff": "^4.0.4",
    "@eslint/plugin-kit": "^0.3.4"
  },
  "jest": {
    "coverageProvider": "v8",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.spec.ts",
      "!src/**/*.e2e.ts",
      "!src/env.d.ts",
      "!src/test-setup.ts",
      "!src/index.ts",
      "!src/index-http.ts",
      "!src/integration/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 96,
        "branches": 82,
        "functions": 93,
        "lines": 96
      },
      "./src/auth.ts": {
        "statements": 100,
        "branches": 85,
        "functions": 100,
        "lines": 100
      },
      "./src/http.ts": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      },
      "./src/token-store/": {
        "statements": 100,
        "branches": 100,
        "functions": 90,
        "lines": 100
      },
      "./src/http-server.ts": {
        "statements": 88,
        "branches": 85,
        "functions": 90,
        "lines": 88
      }
    },
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "preset": "ts-jest",
        "setupFiles": [
          "<rootDir>/src/test-setup.ts"
        ],
        "testMatch": [
          "**/src/**/*.spec.ts"
        ],
        "transform": {
          "^.+\\.ts$": [
            "ts-jest",
            {
              "tsconfig": {
                "module": "CommonJS"
              }
            }
          ]
        },
        "moduleFileExtensions": [
          "ts",
          "js",
          "json"
        ],
        "moduleNameMapper": {
          "^(\\.{1,2}/.*)\\.js$": "$1"
        }
      },
      {
        "displayName": "e2e",
        "testEnvironment": "node",
        "preset": "ts-jest",
        "setupFiles": [
          "<rootDir>/src/test-setup.ts"
        ],
        "testMatch": [
          "**/src/integration/**/*.e2e.ts"
        ],
        "transform": {
          "^.+\\.ts$": [
            "ts-jest",
            {
              "tsconfig": {
                "module": "CommonJS"
              }
            }
          ]
        },
        "moduleFileExtensions": [
          "ts",
          "js",
          "json"
        ],
        "moduleNameMapper": {
          "^(\\.{1,2}/.*)\\.js$": "$1"
        }
      }
    ]
  }
}
